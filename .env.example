# This is an example .env file for the Expo project. Copy this file to a new file named .env and fill in the values for your Firebase project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Gemini API key for VisionService (image classification). Get one at
# https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
